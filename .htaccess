RewriteEngine On

# Принудительный HTTPS для всего сайта, включая /catalog/.
# Учитываем X-Forwarded-Proto, чтобы не создавать цикл редиректов
# на сервере/прокси, который завершает TLS до Apache.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Совместимость со старыми/отсутствующими ссылками на ресурсы
RewriteRule ^images/favicon\.ico$ /images/logo.png [L]
RewriteRule ^images/pervaya_linia\.jpg$ /images/pevraya_linia.jpg [L]
RewriteRule ^images/gsm-hero\.jpg$ /images/gsmoffice.jpg [L]

# Маршрутизация PHP-страниц
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
